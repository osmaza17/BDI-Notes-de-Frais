# ============================================================
#  Copia este archivo como ".env" y ajústalo.
#  El archivo .env NUNCA se sube al repositorio (ver .gitignore).
#
#  Por DEFECTO la app NO necesita clave de API: usa Claude Code
#  instalado y logueado en este ordenador (tu suscripción). Basta con:
#     1) instalar Claude Code   2) ejecutar `claude login` una vez.
#  La API de Anthropic solo se usa como RESPALDO si lo activas abajo
#  (o desde el panel Réglages ⚙).
# ============================================================

# (Opcional, RESPALDO) Usar la API de Anthropic cuando NO haya Claude Code.
# 1 = activar el respaldo a la API · 0 = desactivado (solo Claude Code).
API_FALLBACK=0

# (Opcional, solo si API_FALLBACK=1) Clave de la API de Anthropic.
# La obtienes en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# (Opcional) Modelo a usar (vale para Claude Code y para la API).
# Valores admitidos: claude-haiku-4-5 (rápido/barato) o claude-sonnet-4-6 (más preciso).
# También se puede cambiar desde el panel Réglages (⚙) de la app, sin reiniciar.
ANTHROPIC_MODEL=claude-haiku-4-5

# (Opcional) Puerto del servidor local
PORT=4317
