# ============================================================
#  Copia este archivo como ".env" y rellena tu clave.
#  El archivo .env NUNCA se sube al repositorio (ver .gitignore).
# ============================================================

# Clave de la API de Anthropic (Claude lee los documentos y extrae los datos)
# La obtienes en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# (Opcional) Modelo a usar. Si lo dejas en blanco se usa este por defecto.
ANTHROPIC_MODEL=claude-haiku-4-5

# (Opcional) Puerto del servidor local
PORT=4317
