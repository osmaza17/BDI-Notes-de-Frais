# Claves de API y secretos — NUNCA subir al repo
.env

# Dependencias
node_modules/

# Datos reales (facturas, tickets, attestations, NDF generadas, backups)
# Se conserva la carpeta pero no su contenido sensible
Dossiers/*
!Dossiers/.gitkeep

# Firmas (imágenes personales del tesorero y de los miembros)
Signatures/*
!Signatures/.gitkeep

# Base de datos de personas con datos bancarios (RIB / IBAN) — sensible
personnes.json

# Sistema
.DS_Store
Thumbs.db
npm-debug.log*
